Options -Indexes
RewriteEngine On

# HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block access to source control (in case .git is ever uploaded)
RedirectMatch 404 /\.git

# Protect sensitive files (config, SQL schema, backups, temp)
<FilesMatch "^(api-config\.php|api-config\.example\.php|_secure\.php|schema\.sql|.*\.sql|\.gitignore|\.nojekyll|.*\.log|.*\.tmp|.*\.bak|.*~)$">
  Require all denied
</FilesMatch>

# Block /docs and /tmp entirely
RewriteRule ^(docs|tmp)/ - [F,L]

# SPA: all non-file requests go to index.html (single-page template)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Hotlinking protection (images, videos) — allows own domain + localhost
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?furpal\.com\.br [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?fp2026\.infinityfree\.io [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
RewriteCond %{HTTP_REFERER} !^https?://127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST}@%{HTTP_REFERER} !^([^@]+)@https?://\1 [NC]
RewriteRule \.(jpg|jpeg|png|webp|gif|svg|ico|mp4|webm)$ - [F,NC]

# Brotli compression (preferred, falls back to Gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml image/x-icon font/ttf font/otf
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>
